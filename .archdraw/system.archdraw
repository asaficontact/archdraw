// title: archdraw, the whole system
// summary: One server runs the engine, your repos' diagrams and the agent; the desktop app runs the same server in-process. Every change is a commit on archdraw/update that you approve.

style ours   fill: theme-primary-subtle  border: theme-primary
style store  fill: theme-fill  border: theme-border  badge: database
style ext    border: theme-secondary
style job    fill: none  border: theme-primary
style zone   fill: none  border: theme-border  text: (color: theme-muted)
style dim    text: (color: theme-muted)

node you "You / [dim]browser or desktop app[/dim]"  icon: laptop

node app "archdraw server  [dim]Node · Hono · one process[/dim]"  below you (gap: wide)  style: zone
node app.ui "UI / [dim]React: canvas, inbox, chat[/dim]"  style: ours
node app.api "API + gate / [dim]token, tailnet or local[/dim]"  right of app.ui  style: ours
node app.engine "Engine / [dim]reladraw fork: parse, layout, SVG[/dim]"  below app.ui  style: ours
node app.lib "Library / [dim]clone, worktree, commit, push[/dim]"  right of app.engine  level with app.engine  style: ours
node app.agent "Agent / [dim]skills · read-only tools · propose[/dim]"  below app.engine  style: ours
node app.sync "Hourly sync / [dim]triage, then draft[/dim]"  right of app.agent  style: job

node desktop "Desktop shell / [dim]Electron: window, tray, keychain[/dim]"  left of app (gap: wide)  top level with app  style: ours

node repo "Your repo / [dim].archdraw/ on main · archdraw/update[/dim]"  right of app (gap: wide)  level with app.lib  style: store
node model "AI provider / [dim]your key: OpenAI, Anthropic, Google, OpenRouter[/dim]"  below app (gap: wide)  left level with app  style: ext
node upstream "reladraw / [dim]upstream engine[/dim]"  above repo (gap: wide)  style: ext

edge you -> app.ui  "open"  from: bottom  to: top
edge desktop -> app.api  "starts in-process"  from: right  to: left
edge app.ui -> app.api  "JSON"  from: right  to: left
edge app.api -> app.lib  "read · save"  from: bottom  to: top
edge app.lib -> app.engine  "check, render"  from: left  to: right
edge app.lib <-> repo  "fetch · push · PR"  from: right  to: left
edge app.sync -> app.agent  "draft an update"  from: left  to: right
edge app.agent -> model  "a turn, daily cap"  from: bottom  to: top
edge upstream -> app.engine  "merged by PR"  from: left  to: top
