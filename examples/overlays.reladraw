// A placement's target may be a *part* of a node — its text, one of its four
// sides, or one of its nine points — written as a separate word after the
// node's name. Three direction words go with a part:
//
//   inside   wholly within, against that part
//   outside  wholly beyond it
//   on       centered on it, so a node on a corner straddles it
//
// `inside` and `outside` are shorthands whose expansion is derived rather than
// listed: inside is the direction from the named part toward the box's center,
// outside is away from it. `inside right` is `left of`, `inside top-right` is
// `below-left of`, and nobody writes a table.

style mark   shape: none  text: (color: theme-muted)
style spacer  fill: none  border: none
style link  shape: none  text: (color: #6fa8dc)

// All nine points at once. The board is held open by six invisible children
// with nothing in them, which is also the point being made: a box is sized by
// what it *holds*, and the nine marks stamped on it are not held by anything.
node board ""  fill: theme-fill  border: theme-border
node board.nw ""  style: spacer
node board.n  ""  style: spacer  right of board.nw (gap: 10)
node board.ne ""  style: spacer  right of board.n (gap: 10)
node board.sw ""  style: spacer  below board.nw (gap: wide)
node board.s  ""  style: spacer  right of board.sw (gap: 10)  below board.n (gap: wide)
node board.se ""  style: spacer  right of board.s (gap: 10)   below board.ne (gap: wide)

node p1 "top-left"       inside board top-left       style: mark
node p2 "top-center"     inside board top-center     style: mark
node p3 "top-right"      inside board top-right      style: mark
node p4 "left-center"    inside board left-center    style: mark
node p5 "center"         on board center             style: mark
node p6 "right-center"   inside board right-center   style: mark
node p7 "bottom-left"    inside board bottom-left    style: mark
node p8 "bottom-center"  inside board bottom-center  style: mark
node p9 "bottom-right"   inside board bottom-right   style: mark

// The case the design record names: an ordinary box with its text in the middle
// and, centered at the bottom inside it, a small link.
node bob "Bob the builder"  below board
node bob.card ""  style: spacer
node bob_link "bob.example.com"  inside bob bottom-center  style: link  url: "https://bob.example.com"

// The inset is a named gap on the placement, and `none` puts the node hard
// against the edge, the same as the gap on any other placement.
node plate "A wide plate to stamp on"  right of bob (gap: wide)
node flush "flush"  inside plate top-right (gap: none)  style: mark

// `on` is the thing the old dedicated overlay word could not say: the node's
// center on the point, so it straddles the corner instead of tucking inside.
node dot "A box with a dot on its corner"  below plate (gap: wide)
node straddle "*"  on dot top-right  style: mark

// A side is a segment rather than a point, so the axis it does not name is
// left free — this sits against the right edge and centers down it. The box
// is made wide enough that the mark clears the children.
node column "A tall box"  right of dot (gap: wide)  layout: column  width: 25
node column.one "one"
node column.two "two"
node column.three "three"
node column_mark "inside right"  inside column right  style: mark

// `outside` is the same rule read the other way: wholly beyond the named
// part, which is how a caption sits clear of one edge and no other.
node under "outside bottom"  outside column bottom  style: mark

// A part target works on a picture as readily as on a box. The count is
// bigger than the small picture, so it sits on the corner rather than inside.
node unit  icon: cube  right of plate
node tag "x3"  on unit bottom-right  style: mark

// Saying `inside` or `on` says the overlap is meant, for that pair and nothing
// else: anything else `flush` lands on is still reported.
edge bob -> plate  from: right  to: left
