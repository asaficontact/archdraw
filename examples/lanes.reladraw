// Several lines between the same two sides are copies of one line, and fan out
// side by side instead of lying on top of each other. Copies never cross.

style plain  fill: theme-fill  border: theme-border

// A reciprocal pair around a corner. Each copy is shifted to the left of the
// way it travels, so the order reverses between the two ends: further left
// along Gateway's bottom is further down Queue's left.
node gateway "Gateway"  style: plain
node queue   "Queue"    5 below gateway  22 right of gateway  style: plain
edge gateway -> queue  "publishes"  from: bottom  to: left  line: (path: square, corners: rounded)
edge queue -> gateway  "receives"   from: left    to: bottom  line: (path: square, corners: rounded)

// Two lines facing each other, where the order runs the same way at both ends.
node client "Client"  below queue (gap: wide)  left even with gateway  style: plain
node server "Server"  10 right of client  style: plain
edge client -> server  "request"   from: right  to: left
edge server -> client  "response"  from: left   to: right

// Five copies down a vertical run, spread evenly along the two sides.
node fan  "Fan of five, spread wide"  below client (gap: wide)  left even with gateway  style: plain
node hub  "Hub of the same five"     below fan (gap: wide)  style: plain
edge fan -> hub  "one"    from: bottom  to: top
edge fan -> hub  "two"    from: bottom  to: top
edge fan -> hub  "three"  from: bottom  to: top
edge fan -> hub  "four"   from: bottom  to: top
edge fan -> hub  "five"   from: bottom  to: top

// Two lines pointing the same way. Nothing tells them apart, so the order they
// are written in decides. Swap these two lines and the texts swap lanes.
node left_wall  "Producer"  below hub (gap: wide)  left even with gateway  style: plain
node right_wall "Consumer"  9 right of left_wall  style: plain
edge left_wall -> right_wall  "bulk"     from: right  to: left
edge left_wall -> right_wall  "control"  from: right  to: left

// Sharing one side only doesn't make copies. The far ends differ, and their
// order along the side decides which end is which.
node spoke "Spoke"  below left_wall (gap: 16)  left even with gateway  style: plain
node up    "Up"     above spoke  right of spoke (gap: wide)  style: plain
node down  "Down"   below spoke  right of spoke (gap: wide)  style: plain
edge spoke -> up    from: right  to: left
edge spoke -> down  from: right  to: left

// Five copies need sides long enough to hold them. Nothing grows a box to
// make room, so these two are given the height; at their own height the ends
// would crowd together, drawn and reported.
node narrow "Narrow"  below down (gap: wide)  left even with gateway  height: 10  style: plain
node also   "Also"    9 right of narrow  height: 10  style: plain
edge narrow -> also  "first"   from: right  to: left
edge narrow -> also  "second"  from: right  to: left
edge narrow -> also  "third"   from: right  to: left
edge narrow -> also  "fourth"  from: right  to: left
edge narrow -> also  "fifth"   from: right  to: left
