// Saying where a line passes, with via:. A side is a run along it, just
// outside, from the end nearer the line; a point is one spot the line goes
// through. Between the stops it names, a curved line takes one sweep.

default edge  line: (path: curved)

// A row, with the line sent underneath it: a run under each end box.
node parser "Parser"
node resolver "Resolver"  right of parser
node renderer "Renderer"  right of resolver

edge parser -> renderer  "underneath"  from: left  to: right  via: parser bottom, renderer bottom

// Two runs on opposite sides: down A's left, then down B's right, so the line
// crosses over in the gap between.
node a "A"  below parser  (gap: 14)
node b "B"  below a  (gap: wide)

edge a -> b  "an S"  from: top  to: bottom  via: a left, b right

// Out of the top and round the left.
node p "P"  right of a  (gap: 18)
node q "Q"  below p  (gap: normal)

edge p -> q  "the left"  from: top  to: top  via: p left

// One point, over the middle of Peak's top: the line rises to it and falls.
node t1 "T1"  below b  (gap: 16)
node t2 "T2"  right of t1  (gap: 13)
node peak "Peak"  right of t1  left of t2  above t1  (gap: tight)

edge t1 -> t2  "over a point"  from: right  to: left  via: peak top-center

// Runs under both ends, so the line stays low past Peak2 between them.
node u1 "U1"  right of t2  (gap: wide)
node u2 "U2"  right of u1  (gap: 13)
node peak2 "Peak2"  right of u1  left of u2  above u1  (gap: tight)

edge u1 -> u2  "under both"  from: left  to: right  via: u1 bottom, u2 bottom

// An end naming no side leaves from the one facing the other box.
node x "X"  below t1  (gap: 12)
node z "Z"  right of x
node y "Y"  right of z

edge x -> y  "no sides named"  via: z bottom

// The point between two boxes: the line threads the gap between LN and LM.
node la "LA"  right of y  (gap: wide)
node ln "LN"  below la  (gap: wide)
node lm "LM"  right of ln  (gap: wide)
node lb "LB"  below lm  (gap: wide)

edge la -> lb  "between"  from: bottom  to: top  via: between ln and lm
