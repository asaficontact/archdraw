// `between a and b` is a point: the middle of the space between two things.
// A line passes it with `via:`, and before and after goes wherever its ends
// take it. `at 1/3` moves the point a third of the way across, measured from
// the first thing named.

default edge  line: (path: curved)

style channel  fill: theme-page  border: theme-fill

// North and South are apart vertically, so the point lies in the gap between
// them. Both lines start to the left, pass through the gap and leave for East.
// Two lines through one point would pinch there, so each passes its own:
// a third and two thirds of the way down.

node west   "West"
node lower  "Lower"   below west (gap: tight)
node north  "North"   right of west (gap: wide)   style: channel
node south  "South"   below north (gap: wide)     style: channel
node east   "East"    right of north and south (gap: wide)  even with west

edge west  -> east  "over"   from: right  to: left  via: between north and south at 1/3
edge lower -> east  "under"  from: right  to: left  via: between north and south at 2/3

// Port and Starboard are apart horizontally, so here the line runs down the
// gap instead. This line names no sides, so it leaves Bow's bottom, the side
// facing Stern.

node bow        "Bow"        below lower (gap: wide)
node port       "Port"       below bow (gap: wide)       style: channel
node starboard  "Starboard"  right of port (gap: wide)  style: channel
node stern      "Stern"      below port (gap: wide)

edge bow -> stern  "down"  via: between port and starboard at 1/3

// The same gap travelled the other way, through its own point.

edge stern -> bow  from: top  to: bottom  via: between port and starboard at 2/3

// High and Low sit diagonally, so the space between them is the rectangle
// between their nearest corners, and the point is its middle: under High and
// over Low at once.

node far   "Far"    below stern (gap: wide)
node high  "High"   right of far (gap: wide)  style: channel
node low   "Low"    below-right of high (gap: wide)  style: channel
node near  "Near"   right of low (gap: wide)  even with high

edge far -> near  "threaded"  via: between high and low
