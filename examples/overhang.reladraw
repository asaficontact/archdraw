// Lines that leave the area the nodes cover. The page grows to hold them, on
// every side a line goes past.

default edge  line: (path: square, corners: rounded)

style plain  fill: theme-fill  border: theme-border

node a "A"                            style: plain
node b "B"  right of a  (gap: wide)  width: 5  style: plain
node c "C"  right of b                style: plain

node d "D"  below a and c             style: plain

// A long arch over everything, with the text at the top of it.
edge a -> b  "over the top"  from: top  to: top

// The same shape across a narrow gap.
edge b -> c  from: top  to: top

// Out the left and back into the left, so the loop hangs off the left edge.
edge d -> a  "round the side" (at: 1/4)  from: left  to: left

// Out the right and round into the bottom, under the bottom row.
edge c -> d  "under" (at: 2/3)  from: right  to: bottom
