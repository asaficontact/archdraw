// A child may be placed against its parent's text, or against a side or corner
// of its parent, with the same words used against anything else. Placed against
// the text, it is content: the parent is the outline of its text and children,
// and grows to hold it. Placed against a side or corner, it is put on the
// finished box and never grows it.

style mark  fill: #cdb96f  border: #8f7a3a  text: (color: #111111)

// Four children round the text, one on each diagonal, so the text sits in the
// middle of them.
node corners "Deployment"
node corners.a "north-west"  above-left of corners text
node corners.b "north-east"  above-right of corners text
node corners.c "south-west"  below-left of corners text
node corners.d "south-east"  below-right of corners text

// Two of them below the text and two more below those: a heading over rows.
node band "Deployment"  right of corners (gap: wide)
node band.a "north-west"  below-left of band text
node band.b "north-east"  below-right of band text
node band.c "south-west"  below band.a
node band.d "south-east"  below band.b

// `align:` puts the title along its side: here at the right end of the top.
node ranged "Deployment" (inside top, align: right)  right of band (gap: wide)
node ranged.a "north-west"
node ranged.c "south-west"  below ranged.a
node ranged.d "south-east"  right of ranged.c

// A list is a container: three marks in a column in the order written, beside
// the ordinary contents.
node column "Payments service"  below corners (gap: wide)
node column.api "api"
node column.db "database"  below column.api (gap: tight)
node column.marks ""  right of column.api and column.db  shape: none  layout: column (gap: tight)
node column.marks.one "one"      style: mark
node column.marks.two "two"      style: mark
node column.marks.three "three"  style: mark

// A child above the title, and the contents below it.
node paused "Queue worker"  right of column (gap: wide)
node paused.flag "PAUSED"  above paused text (gap: tight)  style: mark
node paused.jobs "jobs"  below paused text
node paused.retry "retries"  below paused.jobs (gap: tight)

// Beside one child, even with it.
node server "Server"  right of paused (gap: wide)
node server.web "web"
node server.db "database"  below server.web (gap: tight)
node server.cache "cache"  below server.db (gap: tight)
node server.hot "hot"  right of server.db  style: mark

// Beside the text, as a thing of its own: the text stays in the middle, where
// it was put. badge: would make the picture part of the label instead.
node fresh "Release notes"  below column (gap: wide)
node fresh.tag "new"  right of fresh text  style: mark

// On a corner rather than inside it: centered on the point, so it straddles
// the edge.
node dot "Inbox"  right of fresh (gap: wide)
node dot.count "3"  on dot top-right  style: mark

// Beyond the frame. The note is placed on the router's finished box and is no
// part of its size, so the switch is placed right of the note, not the router.
node router "Router"  right of dot (gap: wide)
node router.note "note"  outside router right (gap: tight)  style: mark
node switch "Switch"  right of router.note

// An edge between two children. Its text takes no room of its own, so the
// gap is stated wide enough to hold it.
node pipe "Pipeline"  below fresh (gap: wide)
node pipe.src "source"
node pipe.out "artifact"  15 right of pipe.src
edge pipe.src -> pipe.out  "build and test"  from: right  to: left
