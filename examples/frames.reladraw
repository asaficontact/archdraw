// A child may be placed against its parent's text, or against a side or corner
// of its parent, with the same words used against anything else. Placed against
// the text, it is content: the parent is the outline of its text and children,
// and grows to hold it. Placed against a side or corner, it is put on the
// finished box and never grows it.

style mark  fill: #cdb96f  border: #8f7a3a  text: (color: #111111)

// Four children in two rows, with room left between the columns for the text,
// which sits in the middle.
node corners "Deployment" (center)
node corners.a "north-west"
node corners.b "north-east"  9 right of corners.a
node corners.c "south-west"  below corners.a (gap: 1)
node corners.d "south-east"  below corners.b (gap: 1)

// A title in the top-left corner over two rows, packed a unit apart.
node band "Deployment" (inside top, align: left)  right of corners (gap: wide)
node band.a "north-west"
node band.b "north-east"  right of band.a (gap: 1)
node band.c "south-west"  below band.a (gap: 1)
node band.d "south-east"  below band.b (gap: 1)

// `align:` puts the title along its side: here at the right end of the top.
node ranged "Deployment" (inside top, align: right)  right of band (gap: wide)
node ranged.a "north-west"
node ranged.c "south-west"  below ranged.a (gap: 1)
node ranged.d "south-east"  right of ranged.c (gap: 1)

// A list is a container: three marks in a column in the order written, beside
// the title and the ordinary contents, its top even with the title's.
node column "Payments service" (inside top, align: left)  below corners (gap: wide)
node column.api "api"  below column text (gap: 1)  left even with column text
node column.db "database"  below column.api (gap: 1)  left even with column.api
node column.marks ""  right of column text and column.api and column.db (gap: 1)  top even with column text  shape: none  layout: column (gap: 1)
node column.marks.one "one"      style: mark
node column.marks.two "two"      style: mark
node column.marks.three "three"  style: mark

// A child above the title, and the contents below it, their left sides even
// with the title's.
node paused "Queue worker"  right of column (gap: wide)
node paused.flag "PAUSED"  above paused text (gap: 1)  style: mark
node paused.jobs "jobs"  below paused text (gap: 1)  left even with paused text
node paused.retry "retries"  below paused.jobs (gap: 1)  left even with paused.jobs

// Beside one child, even with it.
node server "Server" (inside top, align: left)  right of paused (gap: wide)
node server.web "web"
node server.db "database"  below server.web (gap: 1)  left even with server.web
node server.cache "cache"  below server.db (gap: 1)  left even with server.db
node server.hot "hot"  right of server.db (gap: 1)  style: mark

// Beside the text, the text and the mark centered in the box together.
node fresh "Release notes" (inside left)  below column (gap: wide)
node fresh.tag "new"  right of fresh text (gap: 1)  style: mark

// On a corner rather than inside it: centered on the point, so it straddles
// the edge.
node dot "Inbox"  right of fresh (gap: wide)
node dot.count "3"  on dot top-right  style: mark

// Beyond the frame. The note is placed on the router's finished box and is no
// part of its size, so the switch is placed right of the note, not the router.
node router "Router"  right of dot (gap: wide)
node router.note "note"  outside router right (gap: tight)  style: mark
node switch "Switch"  right of router.note

// An edge between two children. Its text takes no room of its own, so the
// gap is stated wide enough to hold it.
node pipe "Pipeline" (inside top, align: left)  below fresh (gap: wide)
node pipe.src "source"
node pipe.out "artifact"  15 right of pipe.src
edge pipe.src -> pipe.out  "build and test"  from: right  to: left
