// Gaps belong to placements. Each says exactly how far, and a node has none of
// its own.

style plain  fill: theme-fill  border: theme-border

node left_wall  "Left wall"   style: plain

// Different distances on each side, each on its own placement.
node wedge "Tight left, wide right"  right of left_wall (gap: tight)  style: plain
node right_wall "Right wall"  right of wedge (gap: wide)  style: plain

// Two placements, two gaps: wide below, tight from the wall.
node stack "Wide below the wedge"  below wedge (gap: wide)  right of left_wall (gap: tight)  style: plain

// `none` is contact, and the other placement still keeps its distance.
node shelf "Flat on the stack"  below stack (gap: none)  right of left_wall (gap: tight)  style: plain

edge left_wall -> wedge  from: right  to: left
edge wedge -> right_wall  from: right  to: left

// A gap is written where the relationship is: each neighbor says how far it
// sits from the island, and the island says nothing about them.
node island "Says nothing about its neighbors"  below shelf  style: plain
node east   "Wide from the island"    right of island (gap: wide)  style: plain
node west   "Tight from the island"   left of island (gap: tight)  style: plain
