// A deck is a stack of cards, to say "there are several of these and they are
// the same". The first card is in front, each next one a step up and to the
// left behind it, and every card is as big as the biggest.

style plain  fill: theme-fill  border: theme-border

// The usual case: a front card with rows, and two more like it behind. A card
// that holds things is written as a child, and then every card is.
node drives           ""  layout: deck
node drives.1         "Drive 1" (inside top, align: left)  badge: disk  layout: column (widths: match)
node drives.1.backup  "shared folder / backup"  style: plain
node drives.1.archive "archive"                 style: plain
node drives.2         "Drive 2"
node drives.3         "Drive 3"

// Cards that are only texts are listed with cards:, front first. They are
// named workers.1 and workers.2, so a line can end on one.
node workers ""  right of drives (gap: wide)  layout: deck  cards: "worker" "worker"

// The deck is the whole stack. Something placed above or left of it clears
// every card, so this sits a gap away from the back card, not the front one.
node source "source"  above drives  style: plain

// An annotation may overlap the blank area of the trailing cards, as one
// beside a row does in a drawing, by saying so.
node rotated "swapped weekly"  left of drives.1.backup (gap: tight)  overlap: allow  shape: none
