// Transcribed from a draw.io diagram.

// --- Styles -----------------------------------------------------------------
style synced     fill: theme-primary-subtle  border: theme-primary  line: theme-primary
style dim        text: (color: theme-muted)
style backup     border: #d2904e  line: #d2904e
style dump       fill: theme-secondary-subtle  border: theme-border  shape: document


// --- The hub and its four machines ------------------------------------------
// The cluster is wrapped in an invisible container so things outside it can be
// placed against the whole cluster rather than against the hub alone. Each
// machine's picture is a child placed beside its title, and its folder hangs
// below the title.

node cluster ""  shape: none

node cluster.hub "Cloud sync"  badge: package  style: synced

node cluster.desktop1       "Desktop 1 / Linux"    above-left of cluster.hub (gap: tight)
node cluster.desktop1.icon  icon: desktop  1 right of cluster.desktop1 text
node cluster.desktop1.files "shared folder / [dim]synced[/dim]"  below cluster.desktop1 text  style: synced

node cluster.desktop2       "Desktop 2 / Windows"  above-right of cluster.hub (gap: tight)
node cluster.desktop2.icon  icon: desktop  1 right of cluster.desktop2 text
node cluster.desktop2.files "shared folder / [dim]synced[/dim]"  below cluster.desktop2 text  style: synced

node cluster.laptop1        "Laptop 1 / macOS"     below-left of cluster.hub (gap: tight)
node cluster.laptop1.icon   icon: laptop  1 right of cluster.laptop1 text
node cluster.laptop1.files  "shared folder / [dim]synced[/dim]"  below cluster.laptop1 text  style: synced

node cluster.laptop2        "Laptop 2 / macOS"     below-right of cluster.hub (gap: tight)
node cluster.laptop2.icon   icon: laptop  1 right of cluster.laptop2 text
node cluster.laptop2.files  "shared folder / [dim]synced[/dim]"  below cluster.laptop2 text  style: synced

edge cluster.desktop1.files <-> cluster.hub  style: synced  from: right  to: top
edge cluster.desktop2.files <-> cluster.hub  style: synced  from: left   to: top
edge cluster.laptop1.files  <-> cluster.hub  style: synced  from: right  to: bottom
edge cluster.laptop2.files  <-> cluster.hub  style: synced  from: left   to: bottom


// --- The database dumps -----------------------------------------------------
// The dumps sit a wide gap left of the machines, level with the Docker cubes,
// and the server a gap left of the dumps.

node dumps ""  left of cluster (gap: wide)  even with server.docker  shape: none  layout: column
node dumps.db1 "db dump / (app 1)"  style: dump
node dumps.db2 "db dump / (app 2)"  style: dump

node dumps_note "Written by nightly cron job." (wrap: 30)  below dumps (gap: tight)  shape: none


// --- The server -------------------------------------------------------------

node server         "Home Server"  left of dumps  even with cluster
node server.icon    icon: desktop  1 right of server text
node server.mirror  "shared folder / mirror"  below server text  style: backup
node server.deploy  "deploy dir"  below server.mirror

// The cubes are nodes rather than ornament: two of them are where the dump
// arrows start. The lower pair is centered under the upper three by naming two
// targets and nothing else.
node server.docker  "Docker" (inside bottom)  below server.deploy
node server.docker.a  icon: cube
node server.docker.b  right of server.docker.a (gap: tight)  icon: cube
node server.docker.db1  right of server.docker.b (gap: tight)  icon: cube
node server.docker.c  below server.docker.a and server.docker.b (gap: tight)  icon: cube
node server.docker.db2  below server.docker.b and server.docker.db1 (gap: tight)  icon: cube

edge server.deploy -> server.docker  "compose up"

edge server.docker.db1 -> dumps.db1  from: right  to: left
edge server.docker.db2 -> dumps.db2  from: right  to: left

// The rclone lines run up the channel between the two left-hand machines, so
// the dumps arrive through the middle of the cluster rather than across one.
edge dumps.db1 -> cluster.hub  "rclone"  between cluster.desktop1 and cluster.laptop1  from: right  to: left
edge dumps.db2 -> cluster.hub  "rclone"  between cluster.desktop1 and cluster.laptop1  from: right  to: left

edge cluster.desktop1.files -> server.mirror  "backup script"  style: backup  from: left  to: right
edge cluster.desktop1.files -> server.deploy  "deploy script"                 from: left  to: right


// --- The backup drive -------------------------------------------------------

node drive          "External HD"  left of server  top even with server
node drive.icon     icon: disk  1 right of drive text
node drive.mirror   "shared folder / backup"  below drive text  style: backup
node drive.archive  "archive"  below drive.mirror

edge server.mirror -> drive.mirror  style: backup  from: left  to: right

node drive_note "Swapped with a second drive weekly." (wrap: 22)  left of drive.mirror (gap: tight)  shape: none
