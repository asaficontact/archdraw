// An edge's text takes no room of its own: the gap it sits in is the one the
// placements say, so a text that needs room is given it by stating the gap.

style plain  fill: theme-fill  border: theme-border

// Nothing here says how far apart these two sit, so the gap is `normal`, sized
// for two nodes to breathe and not to hold a word. The text runs over both.
node parser   "Parser"                     style: plain
node resolver "Resolver"  right of parser  style: plain
edge parser -> resolver  "statements"  from: right  to: left

// The same two placements with nothing on the edge, for comparison.
node sink  "Sink"   below parser (gap: wide)  style: plain
node quiet "Quiet"  right of sink       style: plain
edge sink -> quiet  from: right  to: left

// Going downward the text is only a line deep, so a normal gap holds it, and it
// hangs out either side.
//
// Written with `<-`, which draws the same picture as `writer -> disk`. It just
// puts the node the line is about first. `from:` is still the first name
// written, so it names Disk's side.
node writer "Writer"  right of resolver (gap: wide)  style: plain
node disk   "Disk"    below writer                  style: plain
edge disk <- writer  "flushed to disk"  from: top  to: bottom

// A gap stated wide enough for the text.
node roomy "Roomy"        below sink                                 style: plain
node spare "Plenty spare"  right of roomy (gap: wide)  style: plain
edge roomy -> spare  "fits"  from: right  to: left

// Corner to corner, so there is no single gap the text sits in.
node high "High"  right of writer (gap: wide)  style: plain
node low  "Low"   below high  right of high  style: plain
edge high -> low  "diagonal"


// --- What the brackets after a text say ------------------------------------
// A container's title says which side it sits against, and `align` where along
// that side, which also ranges its lines against each other.

style dim  text: (color: theme-muted)

node shelf "Shelf" (inside bottom, align: right)  below roomy (gap: wide)  style: plain
node shelf.one "first"   style: plain
node shelf.two "second"  below shelf.one (gap: tight)  style: plain

// A box is usually the size of its own text. A picture beside the text is two
// lines tall, and lining the picture's top or bottom up with the text's puts
// the text at the top or bottom of the box.
node tall "Top"     right of shelf (gap: wide)  style: plain
node tall.disk  icon: disk  1 right of tall text  top even with tall text
node deep "Bottom"  below tall (gap: tight)  style: plain
node deep.disk  icon: disk  1 right of deep text  bottom even with deep text

// `size` and `wrap` are properties of the text too. The wrap is a count of
// characters, not a distance: it says how much fits on a line and nothing
// about where anything sits.
node aside "A quiet remark that folds itself, with [dim]one word[/dim] quieter than the rest." (size: small, wrap: 28)  right of tall (gap: wide)  shape: none

// A literal bracket is written \[, since [ opens markup.
node literal "sizes \[small, normal, large]"  below aside (gap: tight)  shape: none

// An edge's text takes the same brackets. A size may be a number of pixels as
// well as a name.
edge tall -> aside  "carried" (color: theme-muted, size: 12)  from: right  to: left
