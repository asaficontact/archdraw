{
  "name": "archdraw-studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "archdraw: architecture diagrams for code projects, kept current from git. Core, server and desktop shell.",
  "scripts": {
    "dev": "tsx watch server/src/main.ts",
    "start": "node dist/server.mjs",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@hono/node-server": "^1.19.17",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
