[Unit]
Description=archdraw studio — architecture diagrams of every project, on an infinite canvas; tailnet only, its own origin via Serve https:8445

[Service]
WorkingDirectory=/home/agent3/work/projects/archdraw/studio
Environment=HOME=/home/agent3
Environment=PATH=/home/agent3/.nvm/versions/node/v24.21.0/bin:/home/agent3/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=ARCHDRAW_LIBRARY=/home/agent3/work/brain/projects
Environment=ARCHDRAW_NODE=/home/agent3/.nvm/versions/node/v24.21.0/bin/node
ExecStart=/home/agent3/work/projects/archdraw/studio/.venv/bin/uvicorn --factory archdraw_studio.app:main_app --app-dir server --host 127.0.0.1 --port 8088 --no-access-log --no-proxy-headers
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
