// title: Bean There, the whole system
// summary: How a coffee order goes from the customer's phone to the barista, and how it is paid.

style ours   fill: theme-primary-subtle  border: theme-primary
style store  fill: theme-fill  border: theme-border  badge: database
style ext    border: theme-secondary
style dim    text: (color: theme-muted)

node phone "Customer" icon: desktop
node app "Customer app / [dim]iOS + Android[/dim]"  right of phone (gap: 7)  style: ours
node api "Orders API / [dim]Node[/dim]"  right of app (gap: 10)  style: ours  url: "#/bean-there/ordering"
node queue "Barista queue"  below api (gap: 6)  style: ours
node menu "Menu DB"  right of api (gap: 10)  style: store
node pay "Payments / [dim]card[/dim]"  above api (gap: 6)  style: ours  url: "#/bean-there/payments"
node fax "Fax orders / [dim]legacy[/dim]"  left of queue (gap: 13)  style: ext

edge phone -> app "taps" from: right to: left
edge app -> api "HTTPS" from: right to: left
edge api -> queue "enqueue" from: bottom to: top
edge api -> menu "SQL" from: right-center to: left
edge api -> pay "charge" from: top to: bottom
edge fax -> queue "manual entry" from: right to: left
node loyalty "Loyalty service"  below menu  even with queue  left even with menu  style: ours
node points "Points DB"  right of loyalty (gap: 12)  even with loyalty  style: store
edge api -> loyalty "order paid" from: right 3/4 down  to: left  line: (path: curved)
edge loyalty -> points "add points" from: right to: left
